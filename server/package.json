{
  "name": "@learnsphere/server",
  "version": "1.0.0",
  "private": true,
  "description": "LearnSphere REST API (Express + MongoDB).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
